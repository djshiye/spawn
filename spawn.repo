[spawn]
name=Spawn
baseurl=https://djshiye.github.io/spawn/fedora-$releasever/
enabled=1
# Packages and repository metadata are signed; compare the key fingerprint with the README before trusting it.
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://djshiye.github.io/spawn/RPM-GPG-KEY-spawn
metadata_expire=1h
