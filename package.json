{
  "name": "spawn",
  "version": "1.1.4",
  "description": "Spawn: GNOME Shell application menu (ArcMenu replacement)",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tools/build.sh",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compat:install": "npm ci --prefix tools/compat/49 && npm ci --prefix tools/compat/50",
    "typecheck:compat49": "tools/compat-typecheck.sh 49",
    "typecheck:compat50": "tools/compat-typecheck.sh 50",
    "lint": "eslint .",
    "test": "tools/test.sh",
    "dev:all": "tools/dev-shell.sh all",
    "dev:bench": "tools/dev-shell.sh bench",
    "dev:smoke": "tools/dev-shell.sh smoke",
    "dev:dtp-toggle": "tools/dev-shell.sh dtp-toggle --with-dtp"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@girs/gnome-shell": "51.0.1",
    "@girs/gjs": "^5.6.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
